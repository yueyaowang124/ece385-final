#================================================================
# dds_pdm.mdd  --  Driver metadata for the dds_pdm AXI IP.
# Tells Vitis this is a generic standalone driver.
#================================================================

OPTION psf_version = 2.1;

BEGIN driver dds_pdm

  OPTION supported_peripherals = (dds_pdm);
  OPTION driver_state = ACTIVE;
  OPTION copyfiles = all;
  OPTION VERSION = 1.0;
  OPTION NAME = dds_pdm;

END driver
